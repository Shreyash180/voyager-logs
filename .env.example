DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/voyager_logs?schema=public"

# Public site URL (Vercel domain or custom domain)
NEXT_PUBLIC_SITE_URL="https://voyager-logs.vercel.app"

# Auth (required; use long random values in production)
JWT_ACCESS_SECRET="replace_with_a_long_random_access_secret"
JWT_REFRESH_SECRET="replace_with_a_long_random_refresh_secret"

# Internal services
INTERNAL_API_KEY="replace_with_a_long_random_internal_api_key"
VIEW_HASH_SALT="replace_with_a_random_salt"

# Cloudinary (required for thumbnail upload endpoint)
CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"
CLOUDINARY_FOLDER="voyager-logs"

# Optional observability
SENTRY_DSN=""
